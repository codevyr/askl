COMMENT = _{ "//" ~ (!NEWLINE ~ ANY)* | "/*" ~ (!"*/" ~ ANY)* ~ "*/" }
WHITESPACE = _{(" " | "\t")+}
nl = _{ NEWLINE* }
ident = @{ ("_" | XID_START) ~ XID_CONTINUE* }
string = @{(!"\"" ~ ANY)*}
// NOT silent: a silent rule never appears in pest's "expected ..." set,
// so a bare word in value position used to be told it could be a glob
// string, an integer or a boolean — everything except the plain string
// it almost certainly meant.
quoted_string = { "\"" ~ string  ~ "\""}
// Typed strings: a prefix glued to the opening quote selects the string
// type (g"..." = glob; re"..." reserved for regex).  Unknown prefixes are
// rejected in the parser with a span error, so new types are non-breaking.
string_prefix = @{ ASCII_ALPHA+ }
prefixed_string = ${ string_prefix ~ "\"" ~ string ~ "\"" }
// Primitive literals.  `integer` is 64-bit; the optional sign is accepted by
// the grammar so a nonsensical `limit=-1` fails with the verb's own range
// error rather than an "expected ..." parse dump.  `boolean` is guarded with
// !XID_CONTINUE like or_kw/and_kw/not_kw below, so `inherit=truthy` is a parse
// error instead of `true` followed by garbage; the keywords cannot collide
// with verb idents because they are reachable only from `value`.
integer = @{ "-"? ~ ASCII_DIGIT+ }
boolean = @{ ("true" | "false") ~ !XID_CONTINUE }
// String-only value.  Statement-position uses of a value (a bare selector,
// a forced verb) take THIS, not `value`: a bare `42` or `true` is not a name,
// and "unknown verb" beats a NameSelector over a boolean.
string_value = _{ prefixed_string | quoted_string }
// Typed argument value.  Groundwork for a richer type system: future
// alternatives (list) slot in here.
value = _{ string_value | boolean | integer }
named_argument = ${ident ~ "=" ~ value}
named_arguments = _{named_argument ~ (nl ~ "," ~ nl ~ named_argument)*}
positional_argument = { value }
positional_arguments = _{positional_argument ~ (nl ~ "," ~ nl ~ positional_argument)* }
verb_arguments = _{ nl ~ ((positional_arguments ~ nl ~ "," ~ nl ~ named_arguments) | positional_arguments | named_arguments) ~ nl }
generic_verb = { ident ~ ("(" ~ verb_arguments ~ ")")?}
inherit_label_shortcut = ${ "@@" ~ ident }
label_shortcut = ${ "@" ~ ident }
use_shortcut = ${ "#" ~ ident }
plain_filter = { string_value }
forced_verb = { "!" ~ string_value }
special_verb = _{ plain_filter | forced_verb }
// special_verb must precede generic_verb so a prefixed string like g"foo"
// parses as a filter rather than as verb ident `g` followed by a string.
verb = { inherit_label_shortcut | label_shortcut | use_shortcut | special_verb | generic_verb }
// Boolean operators over predicate verbs.  The keywords are guarded with
// !XID_CONTINUE so idents like `order` don't split; verb names stay ordinary
// idents classified in the builder.  Precedence (not > and > or) lives in
// the PrattParser table in verb/compound.rs, not in layered rules.
or_kw = @{ "or" ~ !XID_CONTINUE }
and_kw = @{ "and" ~ !XID_CONTINUE }
not_kw = @{ "not" ~ !XID_CONTINUE }
// Grouping parens.  A `(` after a verb ident is an argument list
// (generic_verb binds it greedily, spaces included); a `(` in expression
// position is a group.  Newlines are allowed inside groups; a bare newline
// outside parens terminates the statement.
group = { "(" ~ nl ~ compound_expr ~ nl ~ ")" }
comp_atom = _{ group | verb }
compound_expr = _{ not_kw* ~ comp_atom ~ (nl ~ (or_kw | and_kw) ~ nl ~ not_kw* ~ comp_atom)* }
// A single verb with no operators is the degenerate case and behaves
// exactly like the bare verb did.
// A trailing operator continues the statement onto the next line (`nl`
// after the operator).  A newline BEFORE an operator still terminates the
// statement — a line may not start with `or`/`and`.
compound_filter = { not_kw* ~ comp_atom ~ ((or_kw | and_kw) ~ nl ~ not_kw* ~ comp_atom)* }
scope = { "{" ~ statements ~ "}" }
statement = { (compound_filter* ~ scope) | (compound_filter+) | (scope)}
statement_terminator = _{";" | NEWLINE}
statements = _{ (statement_terminator* ~ statement)* ~ statement_terminator* }
ask = _{SOI ~ statements ~ EOI }